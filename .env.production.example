# 复制为 .env.production，并把所有 CHANGE_ME 替换成强随机值。
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_NAME=plssss
DB_USER=bookapp
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# 至少 32 个随机字符；上线后不要随意更换，否则既有令牌和加密字段会失效。
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# 首次启动时自动创建；已存在时不会覆盖密码。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_12_PLUS_CHARACTER_PASSWORD
ADMIN_NAME=系统管理员

# 最终访问地址。域名已解析时填写域名，Caddy 会自动申请 HTTPS 证书。
# 仅 IP 访问时两项都填写 http://服务器IP（此模式没有 HTTPS）。
SITE_ADDRESS=books.example.com
APP_ORIGIN=https://books.example.com
HTTP_PORT=80
HTTPS_PORT=443
LOG_REQUESTS=0
